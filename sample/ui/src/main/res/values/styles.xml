<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/palette_primary</item>
        <item name="colorOnPrimary">@color/palette_onPrimary</item>
        <item name="colorPrimaryContainer">@color/palette_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/palette_onPrimaryContainer</item>
        <item name="colorPrimaryInverse">@color/palette_inversePrimary</item>
        <item name="colorSecondary">@color/palette_secondary</item>
        <item name="colorOnSecondary">@color/palette_onSecondary</item>
        <item name="colorSecondaryContainer">@color/palette_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/palette_onSecondaryContainer</item>
        <item name="android:colorBackground">@color/palette_surface</item>
        <item name="colorOnBackground">@color/palette_onSurface</item>
        <item name="colorSurface">@color/palette_surface</item>
        <item name="colorOnSurface">@color/palette_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/palette_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/palette_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/palette_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/palette_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/palette_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/palette_surfaceContainerHighest</item>
        <item name="colorSurfaceInverse">@color/palette_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/palette_inverseOnSurface</item>
        <item name="colorOutline">@color/palette_outline</item>
        <item name="colorOutlineVariant">@color/palette_outlineVariant</item>
        <item name="colorError">@color/palette_error</item>
        <item name="colorOnError">@color/palette_onError</item>
        <item name="colorErrorContainer">@color/palette_errorContainer</item>
        <item name="colorOnErrorContainer">@color/palette_onErrorContainer</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Sample.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Sample.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Sample.Large</item>

        <item name="textInputStyle">@style/Widget.Sample.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Sample.Card</item>

        <item name="emaActionBarStyle">@style/ActionBarStyle</item>
        <item name="emaAppBarLayoutStyle">@style/AppBarLayoutStyle</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme" />

    <style name="ActionBarStyle">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="AppBarLayoutStyle">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <!--Shapes-->
    <style name="ShapeAppearance.Sample.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Sample.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Sample.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!--Widgets-->
    <style name="Widget.Sample.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Sample.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Sample.Medium</item>
    </style>

    <style name="Widget.Sample.Card.Tonal">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Sample.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Sample.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="Widget.Sample.Avatar" parent="">
        <item name="android:layout_width">@dimen/avatar_size</item>
        <item name="android:layout_height">@dimen/avatar_size</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--Texts-->
    <style name="TextAppearance.Sample.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Sample.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Sample.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

</resources>
